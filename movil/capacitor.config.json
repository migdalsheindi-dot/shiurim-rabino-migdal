{
  "appId": "com.yoelmigdal.shiurim",
  "appName": "Rabino Yoel Migdal",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/file-transfer",
      "@capacitor/filesystem",
      "@capacitor/haptics",
      "@capacitor/keyboard"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
